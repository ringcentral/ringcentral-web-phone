{
  "name": "ringcentral-web-phone",
  "version": "2.5.4",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ringcentral/ringcentral-web-phone.git"
  },
  "license": "MIT",
  "types": "dist/index.d.mts",
  "module": "dist/index.mjs",
  "main": "dist/index.cjs",
  "files": [
    "dist"
  ],
  "targets": {
    "types": false
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check . --write",
    "prepublishOnly": "pnpm build",
    "postpublish": "rm -rf dist",
    "serve": "vite test --strictPort",
    "test": "NODE_OPTIONS=--require=dotenv-override-true/config playwright test --workers=1",
    "upgrade": "pnpm update --latest"
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0",
    "fast-xml-parser": "^5.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.2.0",
    "dotenv-override-true": "^6.2.2",
    "manate": "^2.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-for-async": "^0.8.1"
  },
  "packageManager": "pnpm@10.33.1"
}
